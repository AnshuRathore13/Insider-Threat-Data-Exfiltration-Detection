# Insider Threat & Data Exfiltration Detection Configuration Example
# Copy this file to .env and adjust variables as needed.
# NEVER commit real credentials or production keys to version control.

# Application Environment (development, staging, production)
APP_ENV=development
RANDOM_SEED=42

# Data Generation Parameters
SYNTHETIC_DATA_SAMPLES=20000
RAW_DATA_PATH=data/raw/access_logs.csv
PROCESSED_DATA_PATH=data/processed/featured_access_logs.csv

# Threat Detection Model Hyperparameters
ISOLATION_FOREST_CONTAMINATION=0.03
XGBOOST_N_ESTIMATORS=100
XGBOOST_MAX_DEPTH=6

# Logging & Monitoring
LOG_LEVEL=INFO
