# Data files (keep directory structure via .gitkeep, do not commit large generated or raw logs)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Serialized models
models/*
!models/.gitkeep

# Generated figures and reports
reports/figures/*
!reports/figures/.gitkeep

# Testing & Coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
*.cover
nosetests.xml
coverage.xml

# Jupyter Notebook checkpoints
.ipynb_checkpoints/
*-checkpoint.ipynb

# IDEs and Editors
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.DS_Store
Thumbs.db

# Streamlit local runtime state
.streamlit/
